{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "linux-gcc-debug",
      "displayName": "Linux GCC Debug + ASan/UBSan (-O1)",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_DEBUG": "-O1 -g",
        "CMAKE_CXX_COMPILER": "g++",
        "PSIM_SANITIZE": "ON",
        "PSIM_WERROR": "ON"
      }
    },
    {
      "name": "linux-clang-debug",
      "displayName": "Linux Clang Debug + ASan/UBSan (-O1)",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_DEBUG": "-O1 -g",
        "CMAKE_CXX_COMPILER": "clang++",
        "PSIM_SANITIZE": "ON",
        "PSIM_WERROR": "ON"
      }
    },
    {
      "name": "linux-clang-tidy",
      "displayName": "Linux Clang with clang-tidy (warnings are errors)",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_DEBUG": "-O1 -g",
        "CMAKE_CXX_COMPILER": "clang++",
        "PSIM_CLANG_TIDY": "ON",
        "PSIM_TIDY_WERROR": "ON",
        "PSIM_WERROR": "ON"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux GCC Release (-O2, no sanitizers)",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_CXX_FLAGS_RELEASE": "-O2 -DNDEBUG",
        "PSIM_WERROR": "ON"
      }
    },
    {
      "name": "linux-rerun",
      "displayName": "Linux GCC Release with the Rerun sink (downloads and builds Arrow)",
      "inherits": "linux-release",
      "cacheVariables": {
        "USE_RERUN": "ON"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows MSVC (/W4 /permissive-)",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "PSIM_WERROR": "ON"
      }
    },
    {
      "name": "macos-clang",
      "displayName": "macOS Clang",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "PSIM_WERROR": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "linux-gcc-debug", "configurePreset": "linux-gcc-debug" },
    { "name": "linux-clang-debug", "configurePreset": "linux-clang-debug" },
    { "name": "linux-clang-tidy", "configurePreset": "linux-clang-tidy" },
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "linux-rerun", "configurePreset": "linux-rerun" },
    { "name": "windows-msvc", "configurePreset": "windows-msvc", "configuration": "Debug" },
    { "name": "macos-clang", "configurePreset": "macos-clang" }
  ],
  "testPresets": [
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-clang-debug",
      "configurePreset": "linux-clang-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-clang-tidy",
      "configurePreset": "linux-clang-tidy",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-rerun",
      "configurePreset": "linux-rerun",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "macos-clang",
      "configurePreset": "macos-clang",
      "output": { "outputOnFailure": true }
    }
  ]
}
